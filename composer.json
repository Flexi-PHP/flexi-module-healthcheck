{
  "name": "cubadevops/flexi-module-healthcheck",
  "description": "Health check module for Flexi Framework",
  "version": "1.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "health-check",
    "monitoring"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-factory": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "CubaDevOps\\Flexi\\Modules\\HealthCheck\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "HealthCheck",
      "module-type": "application",
      "config-files": [
        "Config/queries.json",
        "Config/routes.json",
        "Config/services.json"
      ],
      "provides": [
        "health-check",
        "monitoring-endpoint"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CubaDevOps\\Flexi\\Modules\\HealthCheck\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
